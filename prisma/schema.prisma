// This is your Prisma schema file.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Utilisation de l'emplacement par défaut (node_modules/.prisma/client) pour NestJS
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// 0. Enums
// ------------------------------------------

enum Role {
  ADMIN    @map("admin")
  MANAGER  @map("manager")
  EMPLOYE  @map("employe")
}

enum StatutConvocationType {
  ENVOYE    @map("envoye")
  LU        @map("lu")
  ACCEPTE   @map("accepte")
  REFUSE    @map("refuse")
  ANNULE    @map("annule")
}

enum PrioriteConvocation {
  BASSE      @map("basse")
  NORMALE    @map("normale")
  HAUTE      @map("haute")
  URGENTE    @map("urgente")
}

// ------------------------------------------
// 1. Gestion du Personnel et de la Structure
// ------------------------------------------

model Departement {
  id            Int       @id @default(autoincrement())
  nom           String    @unique
  description   String?
  dateCreation  DateTime  @default(now()) @map("date_creation")
  actif         Boolean   @default(true)
  
  // Relations
  employes      Employe[]
  
  @@map("departements")
}

model Employe {
  id              String    @id @default(uuid())
  nomFamille      String    @map("nom_famille")
  prenom          String
  email           String    @unique
  password        String    @map("mot_de_passe") // Doit être stocké haché (Bcrypt)
  role            Role      @default(EMPLOYE)
  dateEmbauche    DateTime  @default(now()) @map("date_embauche")
  dateSortie      DateTime? @map("date_sortie")
  actif           Boolean   @default(true)
  photoProfil String? @map("photo_profil") @db.VarChar(255)
  
  // Relations
  departementId   Int
  departement     Departement @relation(fields: [departementId], references: [id])
  
  // Relations inverses
  convocationsEmises     Convocation[]       @relation("emetteur")
  statutsConvocation     StatutConvocation[]
  messagesEnvoyes        Message[]           @relation("messagesAuteur")
  conversationsCreees    Conversation[]      @relation("createurConversation")
  membresConversation    MembreConversation[]
  
  // Index et contraintes
  @@index([email])
  @@index([departementId])
  @@map("employes")
}

// ------------------------------------------
// 2. Gestion des Convocations et Traçabilité
// ------------------------------------------

model Convocation {
  id              String              @id @default(uuid())
  titre           String
  description     String?
  dateConvocation DateTime            @map("date_convocation")
  heureDebut      String?             @map("heure_debut") // Format: "HH:MM"
  heureFin        String?             @map("heure_fin")   // Format: "HH:MM"
  lieu            String
  priorite        PrioriteConvocation @default(NORMALE)
  dateCreation    DateTime            @default(now()) @map("date_creation")
  dateMiseAJour   DateTime            @updatedAt @map("date_mise_a_jour")
  estAnnulee      Boolean             @default(false) @map("est_annulee")
  
  // Relations
  emetteurId      String
  emetteur        Employe             @relation("emetteur", fields: [emetteurId], references: [id])
  
  // Participants (relation many-to-many via StatutConvocation)
  participants    StatutConvocation[]
  
  // Chat associé
  conversation    Conversation?       @relation(fields: [conversationId], references: [id])
  conversationId  String?             @unique
  
  // Pièces jointes (relation one-to-many)
  piecesJointes   PieceJointe[]
  
  // Index
  @@index([emetteurId])
  @@index([dateConvocation])
  @@map("convocations")
}

model StatutConvocation {
  // Clé primaire composite
  convocationId   String
  employeId       String
  
  @@id([convocationId, employeId]) 

  // Données du statut
  statut          StatutConvocationType @default(ENVOYE)
  dateMiseAJour   DateTime              @default(now()) @map("date_mise_a_jour")
  remarques       String?
  dateLecture     DateTime?             @map("date_lecture")
  
  // Relations
  convocation     Convocation           @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  employe         Employe               @relation(fields: [employeId], references: [id], onDelete: Cascade)
  
  // Index
  @@index([statut])
  @@index([dateMiseAJour])
  @@map("statuts_convocation")
}

model PieceJointe {
  id              String      @id @default(uuid())
  nomFichier      String      @map("nom_fichier") @db.VarChar(255)
  chemin          String      @db.VarChar(255) // Chemin du fichier sur le serveur
  typeMime        String      @map("type_mime") @db.VarChar(100) // Type MIME du fichier
  taille          Int         @default(0) // Taille en octets
  dateUpload      DateTime    @default(now()) @map("date_upload") @db.Timestamptz(6)
  
  // Relations
  convocationId   String     @map("convocation_id")
  convocation     Convocation @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  
  // Index
  @@index([convocationId])
  @@map("pieces_jointes")
}

// ------------------------------------------
// 3. Gestion des Pièces Jointes
// ------------------------------------------

// ------------------------------------------
// 4. Chat de Groupe (Temps Réel)
// ------------------------------------------

model Conversation {
  id              String              @id @default(uuid())
  nom             String              @map("nom_conversation")
  description     String?
  type            String              @map("type_conversation") // "groupe_convocation" ou "direct_message"
  dateCreation    DateTime            @default(now()) @map("date_creation")
  estActive       Boolean             @default(true) @map("est_active")
  
  // Relations
  convocation     Convocation?       // Nullable pour les conversations directes
  createurId      String             @map("createur_id")
  createur        Employe            @relation("createurConversation", fields: [createurId], references: [id])
  
  // Relations inverses
  membres         MembreConversation[]
  messages        Message[]
  
  // Index
  @@index([createurId])
  @@index([type])
  @@map("conversations")
}

model MembreConversation {
  id              String        @id @default(uuid())
  dateAjout       DateTime      @default(now()) @map("date_ajout")
  dateSortie      DateTime?     @map("date_sortie")
  estAdmin        Boolean       @default(false) @map("est_admin")
  
  // Relations
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  employeId       String
  employe         Employe       @relation(fields: [employeId], references: [id], onDelete: Cascade)
  
  // Contrainte d'unicité
  @@unique([conversationId, employeId])
  @@map("membres_conversation")
}

model Message {
  id                String        @id @default(uuid())
  contenu           String
  dateEnvoi         DateTime      @default(now()) @map("date_envoi")
  estModifie        Boolean       @default(false) @map("est_modifie")
  dateModification  DateTime?     @map("date_modification")
  
  // Relations
  conversationId    String
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  auteurId          String
  auteur            Employe       @relation("messagesAuteur", fields: [auteurId], references: [id])
  
  // Pour les messages supprimés
  estSupprime       Boolean       @default(false) @map("est_supprime")
  
  // Index
  @@index([conversationId])
  @@index([auteurId])
  @@index([dateEnvoi])
  @@map("messages")
}